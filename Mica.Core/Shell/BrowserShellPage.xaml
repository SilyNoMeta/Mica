<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mica.Core.Shell.BrowserShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ShellCommandStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Hidden by default: the site gets the whole window. Alt reveals it,
            and the pin keeps it up for users who would rather always see it.
        -->
        <Border
            x:Name="Toolbar"
            Padding="6,3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        x:Name="BackButton"
                        Click="OnBackClick"
                        IsEnabled="False"
                        Style="{StaticResource ShellCommandStyle}"
                        ToolTipService.ToolTip="Précédent (Alt+←)">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        Click="OnForwardClick"
                        IsEnabled="False"
                        Style="{StaticResource ShellCommandStyle}"
                        ToolTipService.ToolTip="Suivant (Alt+→)">
                        <FontIcon FontSize="14" Glyph="&#xE72A;" />
                    </Button>
                    <Button
                        Click="OnReloadClick"
                        Style="{StaticResource ShellCommandStyle}"
                        ToolTipService.ToolTip="Recharger (F5)">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        Click="OnHomeClick"
                        Style="{StaticResource ShellCommandStyle}"
                        ToolTipService.ToolTip="Accueil">
                        <FontIcon FontSize="14" Glyph="&#xE80F;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="2">
                    <ToggleButton
                        x:Name="PinButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnPinClick"
                        Padding="9,6"
                        ToolTipService.ToolTip="Garder la barre affichée">
                        <FontIcon FontSize="14" Glyph="&#xE718;" />
                    </ToggleButton>

                    <Button
                        Style="{StaticResource ShellCommandStyle}"
                        ToolTipService.ToolTip="Réglages">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="330" Spacing="16">

                                    <!--  Zoom  -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Zoom" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Click="OnZoomOutClick"
                                                ToolTipService.ToolTip="Réduire">
                                                <FontIcon FontSize="14" Glyph="&#xE738;" />
                                            </Button>
                                            <TextBlock
                                                x:Name="ZoomText"
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="100 %" />
                                            <Button
                                                Grid.Column="2"
                                                Click="OnZoomInClick"
                                                ToolTipService.ToolTip="Agrandir">
                                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                            </Button>
                                            <Button
                                                Grid.Column="3"
                                                Click="OnZoomResetClick"
                                                Content="100 %"
                                                ToolTipService.ToolTip="Rétablir" />
                                        </Grid>
                                    </StackPanel>

                                    <!--  Extensions  -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Extensions" />
                                        <TextBlock
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Ouvrez le Chrome Web Store, copiez le lien de l'extension puis collez-le ici. Le bouton « Ajouter à Chrome » du store ne fonctionne pas dans une app : Mica télécharge et installe l'extension à sa place."
                                            TextWrapping="Wrap" />
                                        <Button
                                            Click="OnOpenStoreClick"
                                            Content="Ouvrir le Chrome Web Store"
                                            HorizontalAlignment="Stretch" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="ExtensionInput"
                                                PlaceholderText="Lien de l'extension"
                                                Text="" />
                                            <Button
                                                x:Name="InstallExtensionButton"
                                                Grid.Column="1"
                                                Click="OnInstallExtensionClick"
                                                Content="Installer" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="ExtensionStatus"
                                            Opacity="0.75"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                        <ItemsControl x:Name="ExtensionList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0,3" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="OnRemoveExtensionClick"
                                                            Padding="6,3"
                                                            Tag="{Binding Id}"
                                                            ToolTipService.ToolTip="Retirer">
                                                            <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar
            x:Name="LoadingBar"
            Grid.Row="1"
            Height="2"
            IsIndeterminate="False"
            Visibility="Collapsed" />

        <WebView2 x:Name="Browser" Grid.Row="2" />

        <Grid
            x:Name="ErrorOverlay"
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon FontSize="28" Glyph="&#xE783;" />
                <TextBlock
                    x:Name="ErrorText"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
