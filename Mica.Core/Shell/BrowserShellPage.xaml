<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mica.Core.Shell.BrowserShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        No text is written here. In an unpackaged app a class library's own .resw is
        unreachable at runtime, so x:Uid cannot be used: every label and tooltip below
        is assigned in ApplyStrings() from the host executable's resources.
    -->

    <UserControl.Resources>
        <Style x:Key="ShellCommandStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Hidden by default: the site gets the whole window. Alt reveals it,
            and the pin keeps it up for users who would rather always see it.
        -->
        <Border
            x:Name="Toolbar"
            Padding="6,3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        x:Name="BackButton"
                        Click="OnBackClick"
                        IsEnabled="False"
                        Style="{StaticResource ShellCommandStyle}">
                        <!--  Arrows point the other way when the UI is mirrored.  -->
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE72B;"
                            MirroredWhenRightToLeft="True" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        Click="OnForwardClick"
                        IsEnabled="False"
                        Style="{StaticResource ShellCommandStyle}">
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE72A;"
                            MirroredWhenRightToLeft="True" />
                    </Button>
                    <Button
                        x:Name="ReloadButton"
                        Click="OnReloadClick"
                        Style="{StaticResource ShellCommandStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        x:Name="HomeButton"
                        Click="OnHomeClick"
                        Style="{StaticResource ShellCommandStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE80F;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="2">
                    <!--  Installed extensions, the way a browser shows them.  -->
                    <ItemsControl x:Name="ExtensionBar" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Padding="7,6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnExtensionActionClick"
                                    Tag="{Binding ActionUrl}"
                                    ToolTipService.ToolTip="{Binding Name}">
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="{Binding Icon}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ToggleButton
                        x:Name="PinButton"
                        Padding="9,6"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnPinClick">
                        <FontIcon FontSize="14" Glyph="&#xE718;" />
                    </ToggleButton>

                    <Button x:Name="SettingsButton" Style="{StaticResource ShellCommandStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="330" Spacing="16">

                                    <!--  Zoom  -->
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="ZoomHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ZoomOutButton" Click="OnZoomOutClick">
                                                <FontIcon FontSize="14" Glyph="&#xE738;" />
                                            </Button>
                                            <TextBlock
                                                x:Name="ZoomText"
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <Button
                                                x:Name="ZoomInButton"
                                                Grid.Column="2"
                                                Click="OnZoomInClick">
                                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                            </Button>
                                            <Button
                                                x:Name="ZoomResetButton"
                                                Grid.Column="3"
                                                Click="OnZoomResetClick" />
                                        </Grid>
                                    </StackPanel>

                                    <!--  Background  -->
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="BackgroundHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <ToggleSwitch x:Name="BackgroundToggle" Toggled="OnBackgroundToggled" />
                                        <TextBlock
                                            x:Name="BackgroundHint"
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!--  Extensions  -->
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="ExtensionsHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            x:Name="ExtensionsHint"
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="OpenStoreButton"
                                            HorizontalAlignment="Stretch"
                                            Click="OnOpenStoreClick" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ExtensionInput" Text="" />
                                            <Button
                                                x:Name="InstallExtensionButton"
                                                Grid.Column="1"
                                                Click="OnInstallExtensionClick" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="ExtensionStatus"
                                            Opacity="0.75"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                        <ItemsControl x:Name="ExtensionList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0,3" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Padding="6,3"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="OnRemoveExtensionClick"
                                                            Tag="{Binding Id}"
                                                            ToolTipService.ToolTip="{Binding RemoveLabel}">
                                                            <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
            <!--  Surfaces extension installs, which happen outside the settings flyout too.  -->
            <InfoBar
                x:Name="ExtensionPrompt"
                IsClosable="True"
                IsOpen="False">
                <InfoBar.ActionButton>
                    <Button x:Name="PromptInstallButton" Click="OnInstallDetectedClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ProgressBar
                x:Name="LoadingBar"
                Height="2"
                IsIndeterminate="False"
                Visibility="Collapsed" />
        </StackPanel>

        <WebView2 x:Name="Browser" Grid.Row="2" />

        <Grid
            x:Name="ErrorOverlay"
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon FontSize="28" Glyph="&#xE783;" />
                <TextBlock
                    x:Name="ErrorText"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
