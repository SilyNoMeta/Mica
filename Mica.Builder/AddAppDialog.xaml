<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Mica.Builder.AddAppDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <!--  Every label is assigned in ApplyStrings(); see MainWindow.xaml.  -->

    <StackPanel Width="380" Spacing="14">
        <TextBox x:Name="UrlBox" PlaceholderText="gemini.google.com" />

        <TextBlock
            x:Name="HintText"
            Opacity="0.7"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap" />

        <Expander x:Name="OptionsExpander" HorizontalAlignment="Stretch">
            <StackPanel Spacing="14">
                <TextBox x:Name="NameBox" />
                <TextBox x:Name="HostsBox" PlaceholderText="example.com, other.com" />
                <TextBlock
                    x:Name="HostsHintText"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <InfoBar
            x:Name="ErrorBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />

        <StackPanel
            x:Name="BusyPanel"
            Orientation="Horizontal"
            Spacing="10"
            Visibility="Collapsed">
            <ProgressRing
                Width="18"
                Height="18"
                IsActive="True" />
            <TextBlock x:Name="BusyText" VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
