<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Mica.Builder.AppSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Primary"
    mc:Ignorable="d">


    <!--  Every label is assigned in ApplyStrings(); see MainWindow.xaml.  -->

    <!--
        A fixed height, not a maximum. This content is naturally tall enough to make
        the dialog nearly fill the window, and the window's caption buttons are drawn
        by the system above all XAML — so minimise and maximise end up painted across
        the dialog's own top corner. Neither MaxHeight on the control nor overriding
        ContentDialogMaxHeight here constrains the frame; giving the scroller a height
        does, and it scrolls once translations run longer than English.
    -->
    <ScrollViewer
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="400"
            Padding="0,0,4,0"
            Spacing="16">

            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="BackgroundToggle" Toggled="OnBackgroundToggled" />
                <TextBlock
                    x:Name="BackgroundHint"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="StartupToggle" Toggled="OnStartupToggled" />
                <TextBlock
                    x:Name="StartupHint"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="DedicatedToggle" Toggled="OnDedicatedToggled" />
                <TextBlock
                    x:Name="DedicatedHint"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
