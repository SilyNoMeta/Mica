<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Mica.Builder.TransferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Mica.Builder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <!--
        Serves both directions: exporting picks from what is installed, importing
        picks from what the file describes. The question is the same one either way
        — which of these apps — so it is worth asking in the same shape.
    -->

    <StackPanel Spacing="12">
        <TextBlock
            x:Name="BodyText"
            Opacity="0.8"
            TextWrapping="Wrap" />

        <!--  Three-state so a partial selection reads as partial; the click handler keeps it binary.  -->
        <CheckBox
            x:Name="SelectAllBox"
            Click="OnSelectAllClick"
            IsThreeState="True" />

        <ListView
            x:Name="Rows"
            MaxHeight="300"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <CheckBox
                        MinWidth="0"
                        Margin="0,2"
                        AutomationProperties.Name="{Binding Name}"
                        Checked="OnRowToggled"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled}"
                        Unchecked="OnRowToggled">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}" />
                            <TextBlock
                                Opacity="0.65"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding Detail}" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            Said here rather than in a release note: someone moving their apps to a
            new machine is exactly the person who needs to know the sign-ins are not
            coming with them.
        -->
        <InfoBar
            x:Name="NoteBar"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />
    </StackPanel>
</ContentDialog>
