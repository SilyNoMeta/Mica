<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Mica.Builder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Mica.Builder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mica"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Labels are assigned in ApplyStrings(), the same way the shell does it, so
        both projects localise through one mechanism. Strings inside the item
        template travel on the row: a DataTemplate has the row as its data context,
        not the window.
    -->

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Mica" />

        <Grid
            Grid.Row="1"
            Padding="24,12,24,12"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="SubtitleText"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="OnAddClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock x:Name="AddAppText" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <ListView
                x:Name="AppList"
                Padding="16,0,16,16"
                IsItemClickEnabled="True"
                ItemClick="OnAppClick"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="8,10"
                            ColumnSpacing="14"
                            ToolTipService.ToolTip="{Binding Url}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Width="36"
                                Height="36"
                                VerticalAlignment="Center"
                                Source="{Binding Icon}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}" />
                                <TextBlock
                                    Opacity="0.65"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding Host}" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Tag="{Binding Slug}"
                                ToolTipService.ToolTip="{Binding MoreActionsLabel}">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Click="OnOpenAppClick"
                                            Tag="{Binding Slug}"
                                            Text="{Binding OpenLabel}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="OnRefreshIconClick"
                                            Tag="{Binding Slug}"
                                            Text="{Binding RefreshLabel}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Click="OnRemoveAppClick"
                                            Tag="{Binding Slug}"
                                            Text="{Binding RemoveLabel}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <FontIcon
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xECAA;" />
                <TextBlock
                    x:Name="EmptyTitleText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="EmptyBodyText"
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="EmptyAddButton"
                    HorizontalAlignment="Center"
                    Click="OnAddClick"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <Grid
                x:Name="BusyOverlay"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        IsActive="True" />
                    <TextBlock x:Name="BusyText" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            Margin="16,0,16,16"
            IsOpen="False" />
    </Grid>
</Window>
