<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Mica.Host</RootNamespace>
    <AssemblyName>Mica.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Per-app launchers overwrite this with the app's own name; it is the label a
      shell would show if a launcher could not be written.
    -->
    <AssemblyTitle>Mica</AssemblyTitle>
    <Product>Mica</Product>
    <Company>Mica</Company>

    <!-- Fallback when Windows runs in a language Mica does not ship. -->
    <DefaultLanguage>en</DefaultLanguage>

    <!-- Kept in step with Mica.Builder; the release workflow overrides both. -->
    <Version>0.5.0</Version>

    <!--
      Mica deliberately produces plain desktop apps rather than MSIX packages: the
      end user creates apps on demand, so requiring Developer Mode and a package
      registration per app is not acceptable.

      Framework-dependent, not self-contained: the notification stack loads
      Microsoft.WindowsAppRuntime.Insights.Resource.dll, which ships only in the
      Windows App Runtime framework package and is not laid down by a self-contained
      build. Self-contained therefore costs web notifications entirely. The installer
      chains the Windows App Runtime instead.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools/Generate-Resources.ps1 from tools/strings.host.json. -->
    <PRIResource Include="Strings\**\Resources.resw" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mica.Core\Mica.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>
</Project>
